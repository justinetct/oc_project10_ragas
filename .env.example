MISTRAL_API_KEY=your_mistral_api_key_here

# Génération des requêtes SQL des questions chiffrées.
# - controlled (DÉFAUT) : requêtes contrôlées issues d'un mapping figé (mode de production).
# - llm (EXPÉRIMENTAL)  : le LLM génère la requête, validée puis exécutée en lecture seule.
#   À n'activer que pour comparer l'approche « SQL généré » au mode contrôlé.
SQL_GENERATION_MODE=controlled

# Observabilité Logfire (optionnelle).
# Sans LOGFIRE_TOKEN (ou `logfire auth`), l'application tourne en mode local
# silencieux (aucune trace envoyée).
# Write token : https://logfire-eu.pydantic.dev/ -> projet starter-project
#               -> Settings -> Write tokens -> Create write token.
LOGFIRE_TOKEN=
LOGFIRE_ENVIRONMENT=local
# Instance Logfire EU (projet justinetct/starter-project). Vide -> instance par défaut.
LOGFIRE_BASE_URL=https://logfire-eu.pydantic.dev
# Mettre true pour AUSSI afficher les traces dans le terminal (utile en démo).
LOGFIRE_CONSOLE=false
