MISTRAL_API_KEY=your_mistral_api_key_here

# Génération des requêtes SQL des questions chiffrées.
# - llm (RECOMMANDÉ) : le LLM interprète la question, propose une requête SQL,
#   puis la requête est validée et exécutée en lecture seule par le SQL Tool.
#   C'est le mode final retenu pour l'approche agent + Tool.
# - controlled : benchmark sécurisé avec requêtes issues d'un mapping figé.
#   Utile pour comparer les résultats et disposer d'une référence stable,
#   mais moins souple face aux formulations nouvelles ou aux données absentes.
SQL_GENERATION_MODE=llm

# Gabarit de prompt RAG utilisé par la génération (utils/rag_agent.py).
# - prototype (DÉFAUT) : prompt conversationnel d'origine (« NBA Analyst AI »).
# - strict (EXPÉRIMENTAL) : prompt orienté RAG/RAGAS, ancré strictement dans les contextes
#   récupérés et les chiffres SQL, sans complétion par connaissances générales.
#   À n'activer que pour comparer l'ancrage (faithfulness) au prompt prototype ; les
#   résultats RAGAS sont alors suffixés « _prompt_strict » (aucun écrasement).
RAG_PROMPT_MODE=prototype

# Observabilité Logfire (optionnelle).
# Sans LOGFIRE_TOKEN (ou `logfire auth`), l'application tourne en mode local
# silencieux (aucune trace envoyée).
# Write token : https://logfire-eu.pydantic.dev/ -> projet starter-project
#               -> Settings -> Write tokens -> Create write token.
LOGFIRE_TOKEN=
LOGFIRE_ENVIRONMENT=local
# Instance Logfire EU (projet justinetct/starter-project). Vide -> instance par défaut.
LOGFIRE_BASE_URL=https://logfire-eu.pydantic.dev
# Mettre true pour AUSSI afficher les traces dans le terminal (utile en démo).
LOGFIRE_CONSOLE=false
